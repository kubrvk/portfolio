{
  "manifest_version": 3,
  "name": "Hunyuan 3D Batch Downloader",
  "version": "1.1.2",
  "description": "Tencent Hunyuan 3D sayfasındaki tüm assetleri tek tıkla toplu olarak indirin.",
  "icons": {
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://3d.hunyuan.tencent.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "downloads"
  ],
  "host_permissions": [
    "https://3d.hunyuan.tencent.com/*",
    "https://*.myqcloud.com/*"
  ]
}
